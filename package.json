{
	"name": "questmaker-web",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"test": "vitest run",
		"lint": "oxlint --tsconfig tsconfig.json --type-aware --type-check",
		"lint:fix": "oxlint --tsconfig tsconfig.json --type-aware --type-check --fix",
		"lint:tooling": "node --test scripts/lint-tooling.test.mjs",
		"fmt": "oxfmt --write src/",
		"fmt:check": "oxfmt --check src/",
		"check": "pnpm lint && pnpm fmt:check && pnpm lint:tooling",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.60.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-router": "^1.170.39",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-start": "^1.168.58",
		"@tanstack/router-plugin": "^1.168.40",
		"lucide-react": "^1.48.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "^0.8.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.1",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.0.2",
		"wrangler": "^4.141.0"
	}
}
