{
	"name": "questmaker-web",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"test": "vitest run",
		"lint": "oxlint --tsconfig tsconfig.json --type-aware",
		"lint:fix": "oxlint --tsconfig tsconfig.json --type-aware --fix",
		"fmt": "oxfmt --write src/",
		"fmt:check": "oxfmt --check src/",
		"check": "pnpm lint && pnpm fmt:check",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.60.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "^0.7.11",
		"@tanstack/react-router": "^1.170.39",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.58",
		"@tanstack/router-plugin": "^1.168.40",
		"lucide-react": "^0.577.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "^0.3.12",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"jsdom": "^27.4.0",
		"oxfmt": "^0.37.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.11",
		"wrangler": "^4.141.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd",
			"sharp"
		]
	}
}